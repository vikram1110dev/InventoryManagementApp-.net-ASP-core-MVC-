<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Inventory Management System</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Custom Theme CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light">
    <!-- Main Enterprise Navbar -->
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
            <div class="container-fluid px-4">
                <a class="navbar-brand fw-bold d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <span class="badge bg-primary p-2"><i class="bi bi-boxes fs-5"></i></span>
                    <span>Inventory<span class="text-primary">Pro</span></span>
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-1">
                        <li class="nav-item">
                            <a class="nav-link px-3 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active fw-semibold text-white" : "")" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-speedometer2 me-1"></i> Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Inventory" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active fw-semibold text-white" : "")" asp-controller="Inventory" asp-action="Index">
                                <i class="bi bi-search me-1"></i> Stock & Search
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 @(ViewContext.RouteData.Values["action"]?.ToString() == "Transactions" ? "active fw-semibold text-white" : "")" asp-controller="Inventory" asp-action="Transactions">
                                <i class="bi bi-journal-text me-1"></i> Audit Ledger
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Products" ? "active fw-semibold text-white" : "")" asp-controller="Products" asp-action="Index">
                                <i class="bi bi-box-seam me-1"></i> Products
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Warehouses" ? "active fw-semibold text-white" : "")" asp-controller="Warehouses" asp-action="Index">
                                <i class="bi bi-building me-1"></i> Warehouses & Bins
                            </a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center gap-3">
                        <a asp-controller="Products" asp-action="Create" class="btn btn-sm btn-outline-light d-flex align-items-center gap-1">
                            <i class="bi bi-plus-circle"></i> New Product
                        </a>
                        <div class="text-light small border-start ps-3 d-none d-md-block">
                            <i class="bi bi-person-circle text-primary me-1"></i>
                            <span class="fw-semibold">Vikram Kumar</span>
                            <span class="badge bg-secondary ms-1">Admin</span>
                        </div>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid px-4 py-4">
        <!-- Toast / Alert notifications -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm d-flex align-items-center gap-2 mb-4" role="alert">
                <i class="bi bi-check-circle-fill fs-5 text-success"></i>
                <div>@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm d-flex align-items-center gap-2 mb-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill fs-5 text-danger"></i>
                <div>@TempData["ErrorMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top py-3 mt-5 bg-white text-muted small">
        <div class="container-fluid px-4 d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2">
            <div>
                &copy; 2026 <strong>InventoryPro</strong> — Real-Time Warehouse Management System. Built with ASP.NET Core MVC & C#.
            </div>
            <div>
                <span class="badge bg-light text-dark border me-2"><i class="bi bi-database me-1 text-primary"></i> MS SQL Server</span>
                <span class="badge bg-light text-success border"><i class="bi bi-shield-check me-1"></i> ACID Ledger Enabled</span>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
