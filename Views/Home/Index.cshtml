@model InventoryManagementApp.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Real-Time Dashboard";
}

<!-- Page Header -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-speedometer2 text-primary me-2"></i>Warehouse Inventory Dashboard</h2>
        <p class="text-muted mb-0">Real-time stock balance tracking, threshold alerts, and asset distribution.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Inventory" asp-action="Index" class="btn btn-outline-primary d-flex align-items-center gap-1">
            <i class="bi bi-search"></i> Search Inventory
        </a>
        <a asp-controller="Products" asp-action="Create" class="btn btn-primary d-flex align-items-center gap-1">
            <i class="bi bi-plus-lg"></i> Add New Product
        </a>
    </div>
</div>

<!-- KPI Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card stat-card border-0 h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small text-uppercase fw-semibold">Inventory Valuation</div>
                        <div class="fs-3 fw-bold text-dark mt-1">@Model.TotalInventoryValue.ToString("C")</div>
                    </div>
                    <div class="bg-primary-subtle text-primary p-3 rounded-circle">
                        <i class="bi bi-currency-dollar fs-4"></i>
                    </div>
                </div>
                <div class="text-muted small mt-2">
                    <span class="text-success fw-semibold"><i class="bi bi-box-seam me-1"></i>@Model.TotalStockQuantity units</span> across all locations
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card stat-card success-stat border-0 h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small text-uppercase fw-semibold">Active Product SKUs</div>
                        <div class="fs-3 fw-bold text-dark mt-1">@Model.TotalProductsCount</div>
                    </div>
                    <div class="bg-success-subtle text-success p-3 rounded-circle">
                        <i class="bi bi-upc-scan fs-4"></i>
                    </div>
                </div>
                <div class="text-muted small mt-2">
                    <span class="text-secondary">@Model.TotalWarehousesCount Warehouses</span> tracked
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card stat-card alert-stat border-0 h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small text-uppercase fw-semibold">Low Stock Warnings</div>
                        <div class="fs-3 fw-bold text-warning mt-1">@Model.LowStockCount</div>
                    </div>
                    <div class="bg-warning-subtle text-warning p-3 rounded-circle">
                        <i class="bi bi-exclamation-triangle fs-4"></i>
                    </div>
                </div>
                <div class="text-muted small mt-2">
                    <a asp-controller="Inventory" asp-action="Index" asp-route-Status="2" class="text-warning text-decoration-none fw-semibold">
                        View Reorder Alerts <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card stat-card danger-stat border-0 h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small text-uppercase fw-semibold">Out of Stock</div>
                        <div class="fs-3 fw-bold text-danger mt-1">@Model.OutOfStockCount</div>
                    </div>
                    <div class="bg-danger-subtle text-danger p-3 rounded-circle">
                        <i class="bi bi-x-circle fs-4"></i>
                    </div>
                </div>
                <div class="text-muted small mt-2">
                    <a asp-controller="Inventory" asp-action="Index" asp-route-Status="3" class="text-danger text-decoration-none fw-semibold">
                        View Depleted Items <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Main Content Grid -->
<div class="row g-4">
    <!-- Left Column: Low Stock Action Items -->
    <div class="col-lg-7">
        <div class="card border-0 h-100">
            <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-shield-exclamation text-warning me-2"></i>Action Required: Low Stock Items
                </h5>
                <span class="badge bg-warning-subtle text-warning-emphasis">@Model.LowStockAlerts.Count items</span>
            </div>
            <div class="card-body p-0">
                @if (Model.LowStockAlerts.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Product / SKU</th>
                                    <th>Location</th>
                                    <th class="text-center">On Hand</th>
                                    <th class="text-center">Reorder Level</th>
                                    <th class="text-end">Quick Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.LowStockAlerts)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-semibold">@item.Product.Name</div>
                                            <small class="text-muted"><code>@item.Product.SKU</code></small>
                                        </td>
                                        <td>
                                            <span class="location-tag">@item.Location.LocationCode</span>
                                            <div class="small text-muted">@item.Location.Warehouse.Name</div>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge bg-warning text-dark fw-bold">@item.QuantityOnHand</span>
                                        </td>
                                        <td class="text-center text-muted">
                                            @item.ReorderPoint
                                        </td>
                                        <td class="text-end">
                                            <a asp-controller="Inventory" asp-action="StockIn" asp-route-id="@item.Id" class="btn btn-sm btn-outline-success">
                                                <i class="bi bi-plus-circle me-1"></i> Stock In
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-check2-circle text-success fs-1"></i>
                        <p class="mt-2 mb-0">All inventory levels are currently above reorder thresholds!</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Right Column: Recent Activity Ledger -->
    <div class="col-lg-5">
        <div class="card border-0 h-100">
            <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-clock-history text-primary me-2"></i>Recent Stock Movements
                </h5>
                <a asp-controller="Inventory" asp-action="Transactions" class="small text-decoration-none">View All</a>
            </div>
            <div class="card-body p-0">
                <div class="list-group list-group-flush">
                    @foreach (var tx in Model.RecentTransactions)
                    {
                        <div class="list-group-item px-3 py-3 border-0 border-bottom">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="fw-semibold text-truncate" style="max-width: 220px;">@tx.Product.Name</span>
                                @if (tx.QuantityChanged > 0)
                                {
                                    <span class="badge bg-success-subtle text-success fw-bold">+@tx.QuantityChanged</span>
                                }
                                else if (tx.QuantityChanged < 0)
                                {
                                    <span class="badge bg-danger-subtle text-danger fw-bold">@tx.QuantityChanged</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary fw-bold">@tx.QuantityChanged</span>
                                }
                            </div>
                            <div class="d-flex justify-content-between small text-muted">
                                <span>
                                    <span class="badge bg-light text-dark border me-1">@tx.TransactionType</span>
                                    <code>@tx.ReferenceNumber</code>
                                </span>
                                <span>@tx.CreatedAtUtc.ToLocalTime().ToString("MMM dd, HH:mm")</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
