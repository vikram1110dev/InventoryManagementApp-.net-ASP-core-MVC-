@model List<InventoryManagementApp.Models.StockTransaction>
@{
    ViewData["Title"] = "Audit Ledger & Transaction History";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-journal-text text-primary me-2"></i>Stock Movement Audit Ledger</h2>
        <p class="text-muted mb-0">Immutable record of every receipt, dispatch, transfer, and manual balance adjustment.</p>
    </div>
    <div>
        <a asp-action="Index" class="btn btn-outline-primary d-flex align-items-center gap-1">
            <i class="bi bi-box-seam"></i> Live Inventory
        </a>
    </div>
</div>

<!-- Filter Bar -->
<div class="card border-0 mb-4 shadow-sm">
    <div class="card-body p-3">
        <form method="get" asp-action="Transactions" class="row g-2 align-items-center">
            <div class="col-md-5">
                <input type="text" name="search" value="@ViewBag.CurrentSearch" class="form-control form-control-sm" placeholder="Search reference #, SKU, or operator..." />
            </div>
            <div class="col-md-4">
                <select name="type" class="form-select form-select-sm">
                    <option value="">-- All Transaction Types --</option>
                    @foreach (InventoryManagementApp.Models.TransactionType t in Enum.GetValues(typeof(InventoryManagementApp.Models.TransactionType)))
                    {
                        var isSel = (ViewBag.CurrentType != null && (InventoryManagementApp.Models.TransactionType)ViewBag.CurrentType == t);
                        <option value="@t" selected="@isSel">@t</option>
                    }
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-primary flex-grow-1">Filter</button>
                <a asp-action="Transactions" class="btn btn-sm btn-outline-secondary">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Ledger Table -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="ps-3">Timestamp (UTC / Local)</th>
                            <th>Type</th>
                            <th>Reference Doc</th>
                            <th>Product / SKU</th>
                            <th>Warehouse Bin</th>
                            <th class="text-center">Delta</th>
                            <th class="text-center">Balance</th>
                            <th>Operator</th>
                            <th class="pe-3">Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var tx in Model)
                        {
                            <tr>
                                <td class="ps-3 text-nowrap">
                                    <div class="fw-semibold">@tx.CreatedAtUtc.ToLocalTime().ToString("MMM dd, yyyy")</div>
                                    <small class="text-muted">@tx.CreatedAtUtc.ToLocalTime().ToString("hh:mm:ss tt")</small>
                                </td>
                                <td>
                                    @switch (tx.TransactionType)
                                    {
                                        case InventoryManagementApp.Models.TransactionType.Receipt:
                                            <span class="badge bg-success-subtle text-success border border-success-subtle">
                                                <i class="bi bi-box-arrow-in-down me-1"></i>Receipt
                                            </span>
                                            break;
                                        case InventoryManagementApp.Models.TransactionType.Dispatch:
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                                                <i class="bi bi-box-arrow-up me-1"></i>Dispatch
                                            </span>
                                            break;
                                        case InventoryManagementApp.Models.TransactionType.Adjustment:
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">
                                                <i class="bi bi-sliders me-1"></i>Adjustment
                                            </span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary-subtle text-secondary border">@tx.TransactionType</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    <code>@tx.ReferenceNumber</code>
                                </td>
                                <td>
                                    <div class="fw-semibold">@tx.Product.Name</div>
                                    <small class="text-muted"><code>@tx.Product.SKU</code></small>
                                </td>
                                <td>
                                    <span class="location-tag">@tx.Location.LocationCode</span>
                                    <div class="small text-muted">@tx.Location.Warehouse.Name</div>
                                </td>
                                <td class="text-center">
                                    @if (tx.QuantityChanged > 0)
                                    {
                                        <span class="fw-bold text-success">+@tx.QuantityChanged</span>
                                    }
                                    else if (tx.QuantityChanged < 0)
                                    {
                                        <span class="fw-bold text-danger">@tx.QuantityChanged</span>
                                    }
                                    else
                                    {
                                        <span class="fw-bold text-muted">0</span>
                                    }
                                </td>
                                <td class="text-center fw-bold fs-6">
                                    @tx.ResultingBalance
                                </td>
                                <td>
                                    <small class="fw-semibold"><i class="bi bi-person me-1"></i>@tx.CreatedBy</small>
                                </td>
                                <td class="pe-3 small text-muted text-truncate" style="max-width: 200px;">
                                    @(string.IsNullOrEmpty(tx.Notes) ? "—" : tx.Notes)
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-clipboard-x text-muted fs-1"></i>
                <h5 class="mt-3 text-secondary">No transaction records found</h5>
                <p class="text-muted small">Try adjusting your search criteria.</p>
            </div>
        }
    </div>
</div>
