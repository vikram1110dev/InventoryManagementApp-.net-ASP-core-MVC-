@model IEnumerable<InventoryManagementApp.Models.Product>
@{
    ViewData["Title"] = "Product Catalog";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-box-seam text-primary me-2"></i>Product Catalog & Master Assets</h2>
        <p class="text-muted mb-0">Manage product master data, reorder points, unit costs, and warehouse allocations.</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary d-flex align-items-center gap-1">
            <i class="bi bi-plus-circle"></i> Create New Product
        </a>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-3">SKU & Barcode</th>
                        <th>Product Name</th>
                        <th>Category</th>
                        <th class="text-end">Unit Cost</th>
                        <th class="text-end">Selling Price</th>
                        <th class="text-center">Reorder Threshold</th>
                        <th class="text-center">Total Stock</th>
                        <th class="text-end pe-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var totalStock = item.StockBalances.Sum(b => b.QuantityOnHand);
                        <tr>
                            <td class="ps-3">
                                <code class="fw-bold text-primary">@item.SKU</code>
                                @if (!string.IsNullOrEmpty(item.Barcode))
                                {
                                    <div class="small text-muted"><i class="bi bi-upc me-1"></i>@item.Barcode</div>
                                }
                            </td>
                            <td>
                                <div class="fw-bold text-dark">@item.Name</div>
                                <small class="text-muted text-truncate d-inline-block" style="max-width: 250px;">
                                    @item.Description
                                </small>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">@item.Category.Name</span>
                            </td>
                            <td class="text-end font-monospace">
                                @item.UnitCost.ToString("C")
                            </td>
                            <td class="text-end font-monospace">
                                @item.SellingPrice.ToString("C")
                            </td>
                            <td class="text-center">
                                <span class="badge bg-secondary-subtle text-secondary">@item.DefaultReorderPoint units</span>
                            </td>
                            <td class="text-center fw-bold fs-6">
                                @if (totalStock <= 0)
                                {
                                    <span class="badge-stock-out">0</span>
                                }
                                else if (totalStock <= item.DefaultReorderPoint)
                                {
                                    <span class="badge-stock-low">@totalStock</span>
                                }
                                else
                                {
                                    <span class="badge-stock-in">@totalStock</span>
                                }
                            </td>
                            <td class="text-end pe-3">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info" title="View Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary" title="Edit Product">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
