@model InventoryManagementApp.Models.ViewModels.ProductCreateEditViewModel
@{
    ViewData["Title"] = "Create Product";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex align-items-center mb-3">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm me-3">
                <i class="bi bi-arrow-left"></i> Back to Catalog
            </a>
            <h4 class="fw-bold mb-0">Create New Asset / Product</h4>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="SKU" class="form-label fw-semibold">SKU (Stock Keeping Unit) <span class="text-danger">*</span></label>
                            <input asp-for="SKU" class="form-control" placeholder="e.g. ELEC-DELL-5540" />
                            <span asp-validation-for="SKU" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Barcode" class="form-label fw-semibold">Barcode / UPC</label>
                            <input asp-for="Barcode" class="form-control" placeholder="e.g. 884116345678" />
                            <span asp-validation-for="Barcode" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Name" class="form-label fw-semibold">Product Name <span class="text-danger">*</span></label>
                            <input asp-for="Name" class="form-control" placeholder="e.g. Dell Precision 5540 64GB Workstation" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CategoryId" class="form-label fw-semibold">Category <span class="text-danger">*</span></label>
                            <select asp-for="CategoryId" asp-items="Model.CategoryOptions" class="form-select">
                                <option value="">-- Select Category --</option>
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="DefaultReorderPoint" class="form-label fw-semibold">Default Reorder Point <span class="text-danger">*</span></label>
                            <input asp-for="DefaultReorderPoint" class="form-control" type="number" min="0" />
                            <span asp-validation-for="DefaultReorderPoint" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="UnitCost" class="form-label fw-semibold">Unit Cost ($) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="UnitCost" class="form-control" type="number" step="0.01" min="0" />
                            </div>
                            <span asp-validation-for="UnitCost" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="SellingPrice" class="form-label fw-semibold">Selling Price ($) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="SellingPrice" class="form-control" type="number" step="0.01" min="0" />
                            </div>
                            <span asp-validation-for="SellingPrice" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Description" class="form-label fw-semibold">Description / Technical Specifications</label>
                            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Technical specs, model, supplier notes..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="col-12"><hr class="my-3 text-muted"></div>
                        <h6 class="fw-bold text-dark"><i class="bi bi-geo-alt text-primary me-1"></i>Initial Warehouse Stock Allocation (Optional)</h6>

                        <div class="col-md-8">
                            <label asp-for="InitialLocationId" class="form-label fw-semibold">Assign to Warehouse Bin</label>
                            <select asp-for="InitialLocationId" asp-items="Model.LocationOptions" class="form-select">
                                <option value="">-- No initial stock / Assign later --</option>
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="InitialQuantity" class="form-label fw-semibold">Initial Quantity</label>
                            <input asp-for="InitialQuantity" class="form-control" type="number" min="0" />
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-save me-1"></i> Save Product
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
